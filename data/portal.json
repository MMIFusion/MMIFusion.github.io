  "metrics": [
    {
      "id": "EN",
      "name": "信息熵",
      "formula": "EN = − Σ p(k) log₂ p(k)",
      "description": "衡量灰度分布的信息量；本工具使用 256 个灰度级的直方图。",
      "caution": "噪声也可能提高熵，不能单凭 EN 判断融合质量。"
    },
    {
      "id": "SD",
      "name": "标准差",
      "formula": "SD = √[Σ (I − μ)² / N]",
      "description": "衡量灰度的离散程度；采用总体标准差，分母为像素数 N。",
      "caution": "对比度变化会影响 SD，不代表保留了正确的信息。"
    },
    {
      "id": "SF",
      "name": "空间频率",
      "formula": "SF = √{mean[(Δx I)²] + mean[(Δy I)²]}",
      "description": "横纵相邻像素差分各按有效像素对求均值，再合并。",
      "caution": "锐化和噪声也会增大 SF。不同实现的边界归一化可能不同。"
    }
  ],
